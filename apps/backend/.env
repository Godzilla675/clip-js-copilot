# AI Video Editor - Environment Variables

# --- Backend Configuration (apps/backend/.env) ---

# LLM Configuration
# Choose provider: 'anthropic', 'openai', 'gemini', 'copilot', or 'custom'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Path to the copilot CLI binary (leave empty to auto-detect from node_modules)
# COPILOT_CLI_PATH=

# API Keys (fill the one for your selected provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Custom Base URL for OpenAI-compatible providers (e.g. Ollama)
# LLM_BASE_URL=http://localhost:11434/v1

# Asset APIs
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Server Configuration
PORT=3001
# Directory to store project files (absolute or relative to backend root)
PROJECT_DIR=./projects
# Comma-separated list of directories the backend is allowed to read/write (for security)
ALLOWED_DIRS=./projects,./temp

# --- Frontend Configuration (apps/web/.env.local) ---

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
